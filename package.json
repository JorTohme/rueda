    "db:seed": "tsx api/db/seed.ts",
    "test:api:db": "tsx api/vehicles.integration.ts",
    "test:api:auth": "tsx api/auth.integration.ts",
    "test:api:registration": "tsx api/registration.integration.ts",
    "test:api:operations": "tsx api/operations.integration.ts",
    "test:api:documents": "tsx api/documents.integration.ts",
    "test:api:settlements": "tsx api/settlements.integration.ts",
